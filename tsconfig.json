{
  "compilerOptions": {
    "target": "ES2019",
    "module": "None",
    "lib": ["ES2019", "DOM"],
    "outFile": "public/app.js",
    "rootDir": "src",
    "strict": true,
    "noImplicitAny": true,
    "sourceMap": false,
    "removeComments": false,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
