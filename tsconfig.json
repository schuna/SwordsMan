{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "lib": ["ES2020", "DOM"],
    "outDir": "public/dist",
    "rootDir": "src",
    "strict": true,
    "noImplicitAny": true,
    "sourceMap": false,
    "removeComments": false,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
